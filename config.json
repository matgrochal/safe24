          "impact": "Klient nie moze otworzyc karty produktu ani rozpoczac zakupow.",
          "hint": "Sprawdz dostepnosc sklepu, logi PHP i czy produkt nie zostal usuniety z oferty."
        },
        {
          "name": "Dodanie produktu do koszyka",
          "method": "PATCH",
          "url": "https://sklep.technica.pl/pwaapi/cart/me",
          "expected_status": [
            200,
            201
