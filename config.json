          "headers": {
            "Accept": "application/json"
          },
          "required_elements": {
            "potwierdzenie API (code 200)": "\"code\"\\s*:\\s*200",
            "niepusta lista metod platnosci": "\"payment_methods\"\\s*:\\s*\\[\\s*\\{",
            "platnosc za pobraniem": "pobraniem",
            "platnosc internetowa (ING Pay)": "ing_pay|internetowa",
            "co najmniej jedna metoda aktywna": "\"disabled\"\\s*:\\s*false"
          },
          "impact": "Klient nie ma czym zaplacic - przycisk 'Zamow i zaplac' nie zadziala.",
