          "json": {
            "cartItem": {
              "index": 0,
              "sku": "127782",
              "qty": 1,
              "checked_services": [],
              "kit": {},
              "selected_kit_products": null,
              "item_list_id": "monitoring",
              "item_list_name": "Monitoring dostepnosci"
            }
          },
          "required_elements": {
