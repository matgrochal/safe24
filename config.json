          "url": "https://sklep.technica.pl/pwaapi/cart/shipping-methods",
          "expected_status": [
            200
          ],
          "json": {
            "address": {
              "country_id": 10,
              "exclusions": 1
            }
          },
          "required_elements": {
            "potwierdzenie API (code 200)": "\"code\"\\s*:\\s*200",
            "niepusta lista metod dostawy": "\"shippment_methods\"\\s*:\\s*\\[\\s*\\{",
            "przesylka kurierska": "kurierska",
            "co najmniej jedna metoda aktywna": "\"disabled\"\\s*:\\s*false"
          },
          "impact": "Klient dociera do kasy, ale nie ma w czym wybrac dostawy - zamowienie nie przejdzie dalej.",
          "hint": "Sprawdz konfiguracje metod dostawy w panelu sklepu oraz sekcje 'exclusions' w odpowiedzi API - produkt moze byc wykluczony z wszystkich form wysylki."
        },
        {
          "name": "Metody platnosci (etap Dostawa i Platnosc)",
          "method": "GET",
          "url": "https://sklep.technica.pl/pwaapi/cart/payment-methods",
